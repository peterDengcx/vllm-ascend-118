+#!/usr/bin/env bash
+set -euo pipefail
+
+if [[ $# -ne 8 ]]; then
+  echo "Usage: $0 DEVICE_IDS PORT DP_SIZE DP_RANK DP_ADDRESS DP_RPC_PORT TP_SIZE PCP_SIZE" >&2
+  exit 2
+fi
