+        table,
+        snapshot,
+        current,
+        active,
+        sources,
+        anchors,
+        num_reqs,
+        indices.shape[1],
+        snapshot.shape[1],
+        window,
+        snapshot.stride(0),
+        snapshot.stride(1),
+        current.stride(0),
+        current.stride(1),
+        table.stride(0),
+        table.shape[1],
+        indices.shape[-1],
+        PREPARE_BLOCK,
+        num_warps=1,
+    )
+    return True
