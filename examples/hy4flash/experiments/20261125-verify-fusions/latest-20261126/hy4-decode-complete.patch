+        token = pad_lane // TOTAL_HEADS
+        pad_head = pad_lane % TOTAL_HEADS
+        tl.store(
+            output + layer * OUT_LAYER_STRIDE + token * OUT_TOKEN_STRIDE + pad_head * OUT_HEAD_STRIDE,
+            -1,
+            (token >= end) & (token < NTOK),
