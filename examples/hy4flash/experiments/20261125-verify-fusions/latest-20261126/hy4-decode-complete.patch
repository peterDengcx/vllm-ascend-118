+    DEPTH: tl.constexpr,
+    NHEAD: tl.constexpr,
+    TOTAL_HEADS: tl.constexpr,
+    MAX_QUERY: tl.constexpr,
+    PAD_ID: tl.constexpr,
+    PAD_TOKEN: tl.constexpr,
+    VISUAL_IDS: tl.constexpr,
+    BLOCK: tl.constexpr,
+    PAD_BLOCK: tl.constexpr,
