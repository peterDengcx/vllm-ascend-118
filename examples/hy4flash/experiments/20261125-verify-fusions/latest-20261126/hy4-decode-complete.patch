+export ASCEND_GLOBAL_RESOURCE_CONFIG='{"comm_resource_config.link_priority":"PEER2PEER"}'
+export ASCEND_LOCAL_COMM_RES='{"version":"1.3"}'
+export NO_PROXY='*'
+export no_proxy='*'
