@@ -0,0 +1,76 @@
+# SPDX-License-Identifier: Apache-2.0
+"""First-layer iHC with a shared embedding residual."""
+
+import torch
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _hy4_first_ihc_pre(
+    embedding, token_ids, gates, reduced, post,
+    TOKENS: tl.constexpr, VOCAB_SIZE: tl.constexpr, WIDTH: tl.constexpr, CHANNELS: tl.constexpr,
+    TILE: tl.constexpr, ROWS: tl.constexpr,
+):
+    row = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
+    col = tl.program_id(1) * TILE + tl.arange(0, TILE)
+    row_live = row < TOKENS
+    live = row_live[:, None] & (col[None, :] < WIDTH)
+    offset = row[:, None] * WIDTH + col[None, :]
+    token = tl.load(token_ids + row, row_live, other=VOCAB_SIZE)
+    token = tl.where((token >= 0) & (token < VOCAB_SIZE), token, VOCAB_SIZE)
+    gate_row = token * (2 * CHANNELS)
+    x = tl.load(embedding + offset, live, 0).to(tl.float32)
+    mixed = tl.full((ROWS, TILE), 0, tl.float32)
+    for channel in tl.static_range(CHANNELS):
+        pre = tl.load(gates + gate_row + channel, row_live, 0)
+        mixed = mixed + x * pre[:, None]
+        if tl.program_id(1) == 0:
+            p = tl.load(gates + gate_row + CHANNELS + channel, row_live, 0)
+            tl.store(post + row * CHANNELS + channel, p, row_live)
+    tl.store(reduced + offset, mixed, live)
+
+
+@triton.jit
+def _hy4_first_ihc_post(
+    hidden, embedding, post, output,
+    TOKENS: tl.constexpr, WIDTH: tl.constexpr, CHANNELS: tl.constexpr,
+    HIDDEN_ROW_STRIDE: tl.constexpr, HIDDEN_COL_STRIDE: tl.constexpr,
+    TILE: tl.constexpr, ROWS: tl.constexpr,
+):
+    row = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
+    col = tl.program_id(1) * TILE + tl.arange(0, TILE)
+    live = (row[:, None] < TOKENS) & (col[None, :] < WIDTH)
+    offset = row[:, None] * WIDTH + col[None, :]
+    hidden_offset = row[:, None] * HIDDEN_ROW_STRIDE + col[None, :] * HIDDEN_COL_STRIDE
+    x = tl.load(hidden + hidden_offset, live, 0).to(tl.float32)
+    residual = tl.load(embedding + offset, live, 0).to(tl.float32)
+    for channel in tl.static_range(CHANNELS):
+        gate = tl.load(post + row * CHANNELS + channel, row < TOKENS, 0)
+        dst = (row[:, None] * CHANNELS + channel) * WIDTH + col[None, :]
+        tl.store(output + dst, residual + x * gate[:, None], live)
+
+
+def first_ihc_pre(embedding, token_ids, gates):
+    tokens, width = embedding.shape
+    channels = gates.shape[1] // 2
+    reduced = torch.empty_like(embedding)
+    post = torch.empty((tokens, channels), dtype=torch.float32, device=embedding.device)
+    rows, tile = 4, 1024
+    _hy4_first_ihc_pre[(triton.cdiv(tokens, rows), triton.cdiv(width, tile))](
+        embedding, token_ids, gates, reduced, post,
+        tokens, gates.shape[0] - 1, width, channels, tile, rows,
+        num_warps=1, enable_fp_fusion=False,
+    )
+    return reduced, post
+
+
+def first_ihc_post(hidden, embedding, post):
+    tokens, width = embedding.shape
+    channels = post.shape[1]
+    output = torch.empty((tokens, channels, width), dtype=hidden.dtype, device=embedding.device)
+    rows, tile = 4, 1024
+    _hy4_first_ihc_post[(triton.cdiv(tokens, rows), triton.cdiv(width, tile))](
+        hidden, embedding, post, output, tokens, width, channels, hidden.stride(0), hidden.stride(1), tile, rows,
+        num_warps=1, enable_fp_fusion=False,
+    )
+    return output
diff --git a/vllm_ascend/models/hy_v4_flash/index_pool_fp8.py b/vllm_ascend/models/hy_v4_flash/index_pool_fp8.py
index febdde304c42ca0c370ef4ea5ae6652c0acabe48..81ed3897f860dbb92ba359b3ba7ce7681f3982b0 100644
--- a/vllm_ascend/models/hy_v4_flash/index_pool_fp8.py
+++ b/vllm_ascend/models/hy_v4_flash/index_pool_fp8.py
@@ -85,3 +85,42 @@ def encode_indexpool_fp8(vectors: torch.Tensor) -> torch.Tensor:
         transformed, normalized, scale, INDEX_DIM, FP8_MAX, num_warps=1, enable_fp_fusion=False
     )
     return normalized
+
+
+@triton.jit
+def _indexpool_encode_fused(
+    vectors, output, width: tl.constexpr, levels: tl.constexpr, quant_max: tl.constexpr, min_amax: tl.constexpr
+):
+    row = tl.program_id(0)
+    lane = tl.arange(0, width)
+    value = tl.load(vectors + row * width + lane).to(tl.float32)
+    for level in tl.static_range(levels):
+        stride = 1 << level
+        partner = tl.gather(value, lane ^ stride, 0)
+        value = tl.where((lane & stride) == 0, value + partner, partner - value)
+    value = value * (width**-0.5)
+    maximum = tl.maximum(tl.max(tl.abs(value), 0), min_amax)
+    scale = tl.exp2(tl.ceil(tl.log2(maximum / quant_max)))
+    magnitude = tl.minimum(tl.abs(value / scale), quant_max)
+    bits = tl.maximum(magnitude, _E4M3_MIN_NORMAL).to(tl.int32, bitcast=True)
+    exponent = (bits >> _FP32_FRACTION_BITS) - _FP32_EXPONENT_BIAS - _E4M3_FRACTION_BITS
+    unit = ((exponent + _FP32_EXPONENT_BIAS) << _FP32_FRACTION_BITS).to(tl.float32, bitcast=True)
+    inverse_unit = ((_FP32_EXPONENT_BIAS - exponent) << _FP32_FRACTION_BITS).to(tl.float32, bitcast=True)
+    rounded = tl.extra.cann.libdevice.nearbyint(magnitude * inverse_unit)
+    sign = tl.where(value > 0, 1.0, tl.where(value < 0, -1.0, 0.0))
+    tl.store(output + row * width + lane, rounded * unit * sign * scale)
+
+
+def encode_indexpool_fp8_fused(vectors):
+    output = torch.empty_like(vectors, dtype=torch.float32)
+    _indexpool_encode_fused[(vectors.numel() // INDEX_DIM,)](
+        vectors.contiguous(),
+        output,
+        INDEX_DIM,
+        INDEX_DIM.bit_length() - 1,
+        FP8_MAX,
+        _MIN_AMAX,
+        num_warps=1,
+        enable_fp_fusion=False,
+    )
+    return output
diff --git a/vllm_ascend/models/hy_v4_flash/index_pool_fusions.py b/vllm_ascend/models/hy_v4_flash/index_pool_fusions.py
