+@triton.jit(do_not_specialize=["count"])
+def _read_c8_fia_rows(
+    cache, rope_cache, scale_cache, block_table, positions,
+    latent_output, rope_output, mask_output, count,
+    ROW_BYTES: tl.constexpr, PAGE_SIZE: tl.constexpr,
+    LATENT: tl.constexpr, ROPE: tl.constexpr, SCALE_TILE: tl.constexpr, ROWS: tl.constexpr,
+):
+    index = tl.program_id(0) * ROWS + tl.arange(0, ROWS)
