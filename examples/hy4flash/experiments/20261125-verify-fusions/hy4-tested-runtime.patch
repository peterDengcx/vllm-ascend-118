+    group = tl.arange(0, LATENT // SCALE_TILE)
+    scales = tl.load(
+        scale_cache + slot[:, None] * (ROW_BYTES // 4) + (LATENT + 2 * ROPE) // 4 + group[None, :],
+        live[:, None], 0.0,
+    )
