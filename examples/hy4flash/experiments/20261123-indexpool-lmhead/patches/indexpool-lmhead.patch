+            and getattr(layer, "indexer", None) is not None
+            and layer.max_model_len > (layer.indexer.budget + 1) * layer.indexer.ratio
+        ]
+        if not layers or not self.graphs:
+            return
+        long_graphs = self.graphs
+        self.graphs = {}
+        try:
+            for layer in layers:
+                layer._short_indexpool_capture = True
+            super().capture(model, *args, **kwargs)
+            self._short_indexpool_graphs = self.graphs
+            self._short_indexpool_limit = min(
+                (layer.indexer.budget + 1) * layer.indexer.ratio for layer in layers
+            )
+        finally:
+            self.graphs = long_graphs
+            for layer in layers:
+                layer._short_indexpool_capture = False
+        logger.info(
