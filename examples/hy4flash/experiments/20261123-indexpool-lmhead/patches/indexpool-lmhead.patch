+    def capture(self, model, *args, **kwargs):
+        # Both variants use the same descriptors, communication order, output
+        # buffers and graph pool. Only local IndexPool retrieval is omitted.
+        self._short_indexpool_graphs.clear()
+        self._short_indexpool_limit = None
