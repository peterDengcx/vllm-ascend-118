+            len(self._short_indexpool_graphs), self._short_indexpool_limit,
+        )
+
+    def _use_short_indexpool(self, desc):
+        if desc not in self._short_indexpool_graphs or self._short_indexpool_limit is None:
+            return False
+        metadata = self.model_runner.model_state.attn_metadata
+        if not isinstance(metadata, dict) or not metadata:
+            return False
+        # FlashMetadataBuilder copies the runner's CPU sequence-length upper
+        # bounds. A mixed/long batch or unknown metadata keeps the long graph.
+        seen = set()
+        for meta in metadata.values():
+            if id(meta) in seen:
+                continue
+            seen.add(id(meta))
+            lengths = getattr(meta, "seq_lens", None)
+            if not isinstance(lengths, tuple) or not lengths or any(
+                not isinstance(length, int) or length < 0 or length > self._short_indexpool_limit
+                for length in lengths
+            ):
+                return False
+        return True
