+def _kv_quant_sparse_flash_attention_with_sink(
+    query, key, value, sparse_indices, scale, key_quant_mode, value_quant_mode, *, sinks, **kwargs
+):
+    # The installed CANN Python package lacks the newer sink-aware wrapper.
+    # Its existing vLLM custom operator returns partial output plus max/sum;
+    # merge the model's zero-value sink into that softmax exactly.
+    import vllm_ascend.vllm_ascend_C  # noqa: F401
+
+    partial, softmax_max, softmax_sum = (
+        torch.ops._C_ascend.npu_kv_quant_sparse_flash_attention_vllm(
+            query, key, value, sparse_indices, scale,
+            key_quant_mode=key_quant_mode,
+            value_quant_mode=value_quant_mode,
+            return_softmax_lse=True,
+            **kwargs,
+        )
+    )
+    tokens = query.shape[-3] if query.ndim == 4 else query.shape[0]
+    heads = query.shape[-2]
+    lse = softmax_max.float() + softmax_sum.float().clamp_min(1e-30).log()
+    weight = torch.sigmoid(lse.reshape(tokens, heads) - sinks.float())
+    if query.ndim == 4:
+        weight = weight.reshape(1, tokens, heads, 1)
+    else:
+        weight = weight.unsqueeze(-1)
+    return (partial.float() * weight).to(partial.dtype), softmax_max, softmax_sum
 
 
